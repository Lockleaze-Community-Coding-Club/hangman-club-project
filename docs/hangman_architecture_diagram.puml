@startuml
!theme lightgray
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

' C4-Level 3: Flask Web Application with external Persistence (JSON file)
' Inline comments explain components and relationships.

LAYOUT_LEFT_RIGHT()

Person(user, "Player", "User playing Hangman in their browser")

' --------------------------------------
' Overarching system boundary for Hangman Game
' --------------------------------------
System_Boundary(hangman_game, "Hangman Game") {

    ' Containers (C2)
    Container(flask_app, "Flask Web Application") {
        ' app.py: application factory and config - registers routes/blueprints
        Component(app_py, "app.py", "Application Configuration", "Creates Flask app, sets configuration, handles the interface and registers routes to various templates and game objects")
    }

    Container(hangman_code, "Python Game Code") {
        ' play_game_functions.py: runs the game logic
        Component(play_game_functions_py, "hangman_code/play_game_functions.py", "Game Logic and flow", "Orchestrates game, guesses, state management (start_game, make_guess, is_won, is_lost) and persistence dumps. Provides load_game and play_game")
        ' game.py: creates the initial game object
        Component(game_py, "hangman_code/game.py", "Game Object", "Creates game object containing items like the word, previously guessed letters etc")
        ' word_selection.py: manage word lists and choose random words
        Component(word_py, "hangman_code/word_selection.py", "Word Selection", "Loads, sanitises and filters words; provides parse_word, choose_word()")
        Component(functions_for_play_game, "hangman_code/functions_for_play_game.py", "Lower level functions to run the game", "data_handling, game_status_functions, guessed_letters_and_words, make_guess, other_game_data, scores_and_attempts_function, start_game, validate_input")
    }

    ' External Templates Container (C2) - html templates based storage
    Container(user_interface, "Templates that render in the web browser") {
        ' templates and static are components handling presentation
        Component(templates, "templates/", "UI Templates", "Jinja2 templates (index.html, play_game.html, closed.html) used to render pages")
        Component(static, "static/", "Static Assets", "CSS, JS and images used by the UI")
    }

    ' External Persistence Container (C2) - JSON file based storage
    Container(long_term_storage, "JSON file based storage") {
        Container(persistence, "Persistence Store (JSON file)", "File storage", "Durable storage for word lists, saved games and scores (persistence.json)") {
            ' This container is external to Flask process and is accessed via persistence helper module
        }
    }
}

' --------------------------------------
' Relationships
' --------------------------------------
Rel(user, app_py, "Uses (HTTP) - plays game, submits guesses, resumes game, exits game", "HTTP/HTTPS")
Rel(functions_for_play_game, game_py, "Calls for new game object")
Rel(game_py, functions_for_play_game, "Sends new game object when user requests a new game")
Rel(functions_for_play_game, word_py, "Requests random/filtered words from", "Function calls")
Rel(app_py, templates, "Requests HTML template pages")
Rel(templates, static, "References assets from", "templates / static files")
Rel(functions_for_play_game, persistence, "Writes game object /state / scores to, File I/O (JSON)")
Rel(persistence, functions_for_play_game, "Reads game object /state / scores from, File I/O (JSON)")
Rel(play_game_functions_py, app_py, "Send feedback from the game to the user as a game object")
Rel(app_py, play_game_functions_py, "Send game initialisation and guess choices from the user to the play_game function")
Rel(templates, app_py, "Renders HTML pages via Jinja2 templates")
Rel(static, templates, "Serves static assets (CSS, JS)")
Rel(word_py, functions_for_play_game, "Retrieves random word")
Rel(play_game_functions_py, functions_for_play_game, "Request relevant data from functions in accordancce with user action")
Rel(functions_for_play_game, play_game_functions_py, "Send relevant data to play_game in accordancce with user action")
Rel(word_py, persistence, "Stores and retrieves already used words")
Rel(persistence, word_py, "")

@enduml